#!/usr/bin/make -f
# Built by build.sh inside a Debian container with rustup's toolchain.

# installsysusers: the niox group (debian/niox.sysusers), which debhelper
# compat 13 doesn't run by default.
%:
	dh $@ --with installsysusers

override_dh_auto_build:
	cargo build --release --locked -p nioxd -p nioxctl

# The workspace's tests run in development (cargo test), not here.
override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	install -Dm755 target/release/nioxd debian/niox/usr/bin/nioxd
	install -Dm755 target/release/nioxctl debian/niox/usr/bin/nioxctl
	install -Dm644 dist/nioxd.service debian/niox/usr/lib/systemd/system/nioxd.service
	install -Dm644 dist/niox.firewalld.xml debian/niox/usr/lib/firewalld/services/niox.xml
	install -dm755 debian/niox/etc/niox
