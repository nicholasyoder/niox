# Development unit for nioxd: starts it at boot as root, so keyboard/mouse
# work at the login screen. Final packaging (RPM/.deb) ships its own unit.
#
# Install with tools/dev/deploy.sh, or by hand:
#   install -m 0755 target/release/nioxd /usr/local/bin/nioxd
#   install -m 0644 tools/dev/nioxd.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now nioxd
[Unit]
Description=niox keyboard/mouse service (development unit)
After=network.target
# Up before the login screen, so the first thing typed there works.
Before=display-manager.service

[Service]
Type=exec
ExecStart=/usr/local/bin/nioxd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
