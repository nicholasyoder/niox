# niox-session: the optional, per-user half of niox (audio), run by each
# user's service manager (`systemctl --user`). It follows nioxd over
# /run/niox/niox.sock, so it only starts for users in the niox group; nioxd
# and keyboard/mouse never depend on it. On a headless host, run it under a
# lingering user (`loginctl enable-linger <user>`).
[Unit]
Description=niox user session service
Documentation=https://github.com/nicholasyoder/niox
ConditionGroup=niox

[Service]
Type=exec
ExecStart=/usr/bin/niox-session
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
